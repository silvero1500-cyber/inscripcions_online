Options -Indexes
Options -MultiViews

# ── Cabeceras de seguridad ──────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permitir cámara y micrófono solo en el propio origen (para check-in QR)
    Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self)"
    # CSP: 'self' + permitir fonts.googleapis.com y fonts.gstatic.com (Inter), data: para SVG inline en selects, https: para imágenes de eventos
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self';"
</IfModule>

# ── Bloquear acceso directo a directorios sensibles ─────────
<FilesMatch "^\.env|composer\.(json|lock)|schema\.sql">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Rewrite: todo pasa por index.php (Front Controller) ─────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /inscripcions/

    # Ficheros y carpetas físicas → se sirven directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás → front controller
    RewriteRule ^ index.php [L]
</IfModule>

# ── Comprimir respuestas ─────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# ── Cache de assets estáticos ────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg           "access plus 1 month"
    ExpiresByType image/png            "access plus 1 month"
    ExpiresByType image/webp           "access plus 1 month"
</IfModule>
