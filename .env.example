# ============================================================
# Copia este fichero como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# Entorno: development | production
APP_ENV=production
APP_DEBUG=false
APP_URL=https://werun.cat/inscripcions
APP_SECRET=cambia_esto_por_una_cadena_aleatoria_de_64_chars

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nombre_base_datos
DB_USER=usuario_bd
DB_PASS=contrasenya_bd

# ────────────────────────────────────────────────────────
# Redsys TPV Virtual (suporta targeta + Bizum)
# ────────────────────────────────────────────────────────
# ENVIRONMENT: 'sandbox' o 'production'.
#   sandbox    → POST a https://sis-t.redsys.es:25443/sis/realizarPago
#   production → POST a https://sis.redsys.es/sis/realizarPago
REDSYS_ENVIRONMENT=sandbox

# Codi de comerç i terminal (els proporciona el banc en el panell del TPV)
REDSYS_MERCHANT_CODE=347900201
REDSYS_TERMINAL=0002

# Clau SHA-256 (base64). En sandbox pots usar la genèrica de proves:
#   sq7HjrUOBfKmC576ILgskD5srU870gJ7
# En producció, posa la clau real provista pel banc — NO la pugis al repo.
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7

# Moneda ISO-4217 numèric (978 = EUR)
REDSYS_CURRENCY=978

# Email (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@werun.cat
MAIL_FROM_NAME=WeRun Inscripcions
MAIL_ENCRYPTION=tls

# Rutas internas (relativas al document root del subdir)
UPLOAD_MAX_SIZE_MB=5
