Options -Indexes
Options -MultiViews

# ── Cabeceras de seguridad ──────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS: força HTTPS al navegador durant 180 dies (només té efecte sobre HTTPS).
    # Sense includeSubDomains per no afectar altres subdominis de werun.cat.
    Header always set Strict-Transport-Security "max-age=15552000"
    # Permitir cámara y micrófono solo en el propio origen (para check-in QR)
    Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self)"
    # CSP: 'self' + fonts.googleapis/gstatic (Inter), data: per SVG inline, https: per imatges.
    # form-action inclou els dominis de Redsys (el pagament fa POST cap allà: prod + sandbox).
    # object-src 'none' (sense plugins), base-uri 'self' (anti-injecció de <base>),
    # frame-ancestors 'self' (anti-clickjacking, coherent amb X-Frame-Options).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://sis.redsys.es https://sis-t.redsys.es:25443;"
</IfModule>

# ── Bloquear acceso directo a directorios sensibles ─────────
<FilesMatch "^\.env|composer\.(json|lock)|schema\.sql">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Rewrite: todo pasa por index.php (Front Controller) ─────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /inscripcions/

    # Ficheros y carpetas físicas → se sirven directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás → front controller
    RewriteRule ^ index.php [L]
</IfModule>

# ── Comprimir respuestas ─────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# ── Cache de assets estáticos ────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg           "access plus 1 month"
    ExpiresByType image/png            "access plus 1 month"
    ExpiresByType image/webp           "access plus 1 month"
</IfModule>
